/* pages/record-add/record-add.wxss */
.form { padding: 28rpx 28rpx 60rpx; }

.form-header { text-align: center; padding: 30rpx 0 40rpx; }
.fh-ico { font-size: 88rpx; }
.fh-title { font-size: 38rpx; font-weight: 700; margin-top: 16rpx; }
.fh-unit { font-size: 24rpx; color: var(--c-text-3); margin-top: 8rpx; }

.field { margin-bottom: 20rpx; }
.field-label { font-size: 26rpx; color: var(--c-text-2); margin-bottom: 16rpx; }
.field-input {
  font-size: 34rpx; font-weight: 600; color: var(--c-text);
  padding: 8rpx 0; border-bottom: 2rpx solid var(--c-line);
}
.field-input.picker { line-height: 1.6; }

.tip {
  font-size: 22rpx; color: var(--c-text-3); padding: 8rpx 8rpx 24rpx;
}
.btn-primary { margin-top: 16rpx; }
