/* pages/weight/weight.wxss */
.w-page { padding: 28rpx 28rpx 40rpx; }

/* 摘要卡 */
.summary {
  background: linear-gradient(145deg, #0E7C66, #10997C);
  border-radius: 24rpx; padding: 32rpx; color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(14,124,102,0.26);
}
.sum-label { font-size: 24rpx; opacity: 0.85; }
.sum-num { font-size: 64rpx; font-weight: 700; line-height: 1.1; margin-top: 6rpx; }
.sum-unit { font-size: 28rpx; opacity: 0.85; margin-left: 4rpx; }
.target-info { text-align: right; }
.ti-diff { font-size: 40rpx; font-weight: 700; }
.ti-diff.up { color: #FFD93D; }
.ti-diff.down { color: #A6F0FF; }
.ti-label { font-size: 22rpx; opacity: 0.85; margin-top: 4rpx; }

.sum-actions { margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(255,255,255,0.2); display: flex; gap: 16rpx; }
.action-btn {
  flex: 1; text-align: center; padding: 16rpx 0;
  background: rgba(255,255,255,0.2); border-radius: 12rpx;
  font-size: 26rpx; font-weight: 600;
}

/* 热量卡 */
.calorie-card {
  background: var(--c-surface);
  border-radius: 24rpx; padding: 28rpx; margin-top: 24rpx;
  box-shadow: var(--shadow-soft);
}
.cc-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.cc-badge {
  padding: 8rpx 20rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 600;
}
.cc-badge.light { background: #FBE9E7; color: #E8604D; }
.cc-badge.normal { background: var(--c-primary-soft); color: var(--c-primary); }
.cc-badge.heavy { background: #FBF0DC; color: #C8841F; }
.cc-trend { font-size: 22rpx; color: var(--c-text-2); }

.cc-main { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; }
.cc-item { text-align: center; padding: 20rpx; background: var(--c-surface-2); border-radius: 16rpx; }
.ci-num { font-size: 40rpx; font-weight: 700; color: var(--c-primary); line-height: 1; }
.ci-unit { font-size: 20rpx; color: var(--c-text-3); margin-left: 2rpx; }
.ci-label { font-size: 22rpx; color: var(--c-text-2); margin-top: 8rpx; }

/* Section header */
.section-header { display: flex; justify-content: space-between; align-items: center; margin: 36rpx 4rpx 16rpx; }
.refresh-btn { font-size: 26rpx; color: var(--c-primary); }

/* 食谱列表 */
.meal-list { display: flex; flex-direction: column; gap: 16rpx; }
.meal-card { padding: 24rpx; }
.meal-head { display: flex; justify-content: space-between; align-items: center; }
.meal-time { font-size: 30rpx; font-weight: 600; }
.meal-cal { font-size: 28rpx; font-weight: 700; color: var(--c-primary); }
.meal-name { font-size: 28rpx; font-weight: 600; margin-top: 16rpx; }
.meal-items { font-size: 24rpx; color: var(--c-text-2); margin-top: 10rpx; line-height: 1.55; }
.meal-actions { margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx dashed var(--c-line); }
.meal-btn { display: inline-block; font-size: 24rpx; color: var(--c-primary); padding: 6rpx 16rpx; background: var(--c-primary-soft); border-radius: 8rpx; }
.meal-total { text-align: center; font-size: 26rpx; color: var(--c-text-2); margin-top: 12rpx; padding: 16rpx; background: var(--c-surface-2); border-radius: 12rpx; }
.total-gap { color: var(--c-text-3); margin-left: 8rpx; }

/* 趋势图 */
.trend-card { padding: 24rpx; }
.trend-chart { display: flex; align-items: flex-end; height: 220rpx; gap: 10rpx; }
.tc-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
.tc-track { flex: 1; width: 100%; display: flex; align-items: flex-end; justify-content: center; }
.tc-bar { width: 60%; max-width: 38rpx; background: linear-gradient(180deg, #1AA88A, #0E7C66); border-radius: 8rpx 8rpx 2rpx 2rpx; min-height: 4rpx; transition: height 0.4s; }
.tc-val { font-size: 18rpx; color: var(--c-text-2); margin-top: 6rpx; }
.tc-label { font-size: 20rpx; color: var(--c-text-3); margin-top: 4rpx; }

/* 建议列表 */
.tip-list { display: flex; flex-direction: column; gap: 16rpx; }
.tip-item { display: flex; align-items: flex-start; gap: 16rpx; padding: 24rpx; }
.tip-ico { font-size: 36rpx; }
.tip-text { font-size: 26rpx; line-height: 1.6; }

.bottom-space { height: 80rpx; }
