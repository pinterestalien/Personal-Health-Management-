/* pages/exercise/exercise.wxss */
.ex-page { padding: 28rpx 28rpx 120rpx; }

.summary {
  display: flex; align-items: center; justify-content: space-around;
  background: linear-gradient(145deg, #0E7C66, #10997C);
  border-radius: 24rpx; padding: 32rpx 20rpx; color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(14,124,102,0.26);
}
.sum-item { text-align: center; flex: 1; }
.sum-num { font-size: 44rpx; font-weight: 700; line-height: 1.1; }
.sum-u { font-size: 22rpx; opacity: 0.85; margin-left: 4rpx; }
.sum-label { font-size: 22rpx; opacity: 0.85; margin-top: 8rpx; }
.sum-div { width: 1rpx; height: 60rpx; background: rgba(255,255,255,0.25); }

.filters { white-space: nowrap; margin: 28rpx 0; }
.filter-inner { display: inline-flex; gap: 14rpx; padding: 4rpx; }
.filter {
  display: inline-block; padding: 12rpx 28rpx; border-radius: 999rpx;
  background: var(--c-surface); color: var(--c-text-2); font-size: 26rpx;
  box-shadow: var(--shadow-soft);
}
.filter.on { background: var(--c-primary); color: #fff; }

.list { }
.ex { display: flex; align-items: center; padding: 26rpx; margin-bottom: 16rpx; gap: 20rpx; }
.ex-ico {
  width: 84rpx; height: 84rpx; border-radius: 20rpx; flex-shrink: 0;
  background: var(--c-primary-soft); color: var(--c-primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 700;
}
.ex-main { flex: 1; }
.ex-title { font-size: 30rpx; font-weight: 600; }
.ex-meta { font-size: 22rpx; color: var(--c-text-3); margin-top: 4rpx; }
.ex-stats { margin-top: 10rpx; }
.es { font-size: 26rpx; color: var(--c-text); font-weight: 600; }
.es-dot { color: var(--c-text-3); margin: 0 10rpx; }
.ex-note { font-size: 24rpx; color: var(--c-text-2); margin-top: 8rpx; }
.ex-del { font-size: 24rpx; color: var(--c-warn); padding: 10rpx 16rpx; }
