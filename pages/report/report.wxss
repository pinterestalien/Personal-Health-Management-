/* pages/report/report.wxss */
.rep-page { padding: 28rpx 28rpx 60rpx; }

.rep-head { padding: 8rpx 4rpx 28rpx; }
.rh-title { font-size: 40rpx; font-weight: 700; }
.rh-sub { font-size: 24rpx; color: var(--c-text-3); margin-top: 6rpx; }

.avg-grid { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.avg { flex: 1; text-align: center; padding: 26rpx 12rpx; }
.avg-num { font-size: 44rpx; font-weight: 700; color: var(--c-primary); line-height: 1; }
.avg-u { font-size: 20rpx; color: var(--c-text-3); margin-top: 4rpx; }
.avg-l { font-size: 22rpx; color: var(--c-text-2); margin-top: 10rpx; }

.ex-sum { margin-bottom: 24rpx; }
.ex-stats { display: flex; align-items: center; margin-top: 20rpx; }
.es-cell { flex: 1; text-align: center; }
.es-num { font-size: 40rpx; font-weight: 700; }
.es-l { font-size: 22rpx; color: var(--c-text-3); margin-top: 4rpx; }
.es-div { width: 1rpx; height: 56rpx; background: var(--c-line); }

.chart-card { margin-bottom: 24rpx; }
.block-title { display: block; margin: 16rpx 4rpx; }

/* line chart (体重) */
.line-chart { }
.line-area { display: flex; align-items: flex-end; height: 220rpx; gap: 8rpx; padding-top: 16rpx; }
.line-bar {
  flex: 1; background: linear-gradient(180deg, #1AA88A, #0E7C66);
  border-radius: 8rpx 8rpx 2rpx 2rpx; min-height: 4rpx; transition: height 0.4s;
}
.x-labels { display: flex; justify-content: space-between; margin-top: 10rpx; }
.x-labels text { flex: 1; text-align: center; font-size: 20rpx; color: var(--c-text-3); }

/* bar chart */
.bar-chart { display: flex; align-items: flex-end; height: 240rpx; gap: 14rpx; padding-top: 16rpx; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
.bar-track { flex: 1; width: 100%; display: flex; align-items: flex-end; justify-content: center; }
.bar { width: 60%; max-width: 44rpx; background: linear-gradient(180deg, #1AA88A, #0E7C66); border-radius: 10rpx 10rpx 4rpx 4rpx; min-height: 6rpx; transition: height 0.4s; }
.bar-label { font-size: 20rpx; color: var(--c-text-3); margin-top: 8rpx; }

/* tips */
.tip { display: flex; align-items: flex-start; gap: 18rpx; padding: 24rpx; margin-bottom: 16rpx; }
.tip-ico { font-size: 38rpx; }
.tip-text { font-size: 26rpx; color: var(--c-text); line-height: 1.6; }
