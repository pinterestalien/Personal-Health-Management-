<!-- pages/medication-add/medication-add.wxml -->
<view class="form">
  <view class="card field">
    <view class="field-label">药品名称</view>
    <input class="field-input" placeholder="如：维生素D" value="{{name}}" bindinput="onName" />
  </view>

  <view class="card field">
    <view class="field-label">剂量</view>
    <input class="field-input" placeholder="如：1粒" value="{{dosage}}" bindinput="onDosage" />
  </view>

  <view class="card field">
    <view class="field-label">服药时间</view>
    <picker mode="time" value="{{time}}" bindchange="onTime">
      <view class="field-input picker">{{time}}</view>
    </picker>
  </view>

  <view class="card field">
    <view class="field-label">服药频次</view>
    <picker mode="selector" range="{{frequencyList}}" value="{{frequencyIndex}}" bindchange="onFreq">
      <view class="field-input picker">{{frequencyList[frequencyIndex]}}</view>
    </picker>
  </view>

  <view class="card field">
    <view class="field-label">备注（可选）</view>
    <input class="field-input" placeholder="如：餐后服用" value="{{note}}" bindinput="onNote" />
  </view>

  <button class="btn-primary" bindtap="save">添加提醒</button>
</view>
