<!-- pages/profile/profile.wxml -->
<view class="pf-page">
  <!-- 用户卡 -->
  <view class="user-card">
    <view class="avatar">{{profile.name ? profile.name.charAt(0) : '我'}}</view>
    <view class="col flex1">
      <view class="u-name">{{profile.name}}</view>
      <view class="u-info">{{profile.gender}} · {{profile.age}}岁 · {{profile.height}}cm</view>
    </view>
    <view class="u-edit" bindtap="goEdit">编辑</view>
  </view>

  <!-- BMI -->
  <view class="card bmi-card">
    <view class="row-between">
      <view class="col">
        <view class="bmi-label">身体质量指数 BMI</view>
        <view class="bmi-val">{{bmi ? bmi : '—'}}</view>
      </view>
      <view class="tag {{bmiCls}}">{{bmiText}}</view>
    </view>
    <view class="bmi-bar">
      <view class="bmi-seg seg-1"></view>
      <view class="bmi-seg seg-2"></view>
      <view class="bmi-seg seg-3"></view>
      <view class="bmi-seg seg-4"></view>
    </view>
    <view class="bmi-legend">
      <text>偏瘦</text><text>正常</text><text>超重</text><text>肥胖</text>
    </view>
  </view>

  <!-- 健康目标 -->
  <text class="section-title block-title">健康目标</text>
  <view class="card goals">
    <view class="goal-row">
      <text class="goal-l">每日步数</text>
      <text class="goal-v">{{goals.steps}} 步</text>
    </view>
    <view class="goal-row">
      <text class="goal-l">每日饮水</text>
      <text class="goal-v">{{goals.water}} ml</text>
    </view>
    <view class="goal-row">
      <text class="goal-l">每日睡眠</text>
      <text class="goal-v">{{goals.sleep}} 小时</text>
    </view>
    <view class="goal-row last">
      <text class="goal-l">目标体重</text>
      <text class="goal-v">{{goals.weight}} kg</text>
    </view>
  </view>

  <!-- 统计 -->
  <text class="section-title block-title">数据统计</text>
  <view class="stats">
    <view class="stat card">
      <view class="stat-num">{{recordCount}}</view>
      <view class="stat-l">健康记录</view>
    </view>
    <view class="stat card">
      <view class="stat-num">{{exerciseCount}}</view>
      <view class="stat-l">运动次数</view>
    </view>
    <view class="stat card">
      <view class="stat-num">{{medCount}}</view>
      <view class="stat-l">用药提醒</view>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="menu card">
    <view class="menu-row" bindtap="goReport">
      <text class="m-ico">📊</text>
      <text class="m-label flex1">健康报告</text>
      <text class="m-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goPeriod">
      <text class="m-ico">🌸</text>
      <text class="m-label flex1">经期管理</text>
      <text class="m-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goEdit">
      <text class="m-ico">👤</text>
      <text class="m-label flex1">编辑资料</text>
      <text class="m-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="clearData">
      <text class="m-ico">🗑️</text>
      <text class="m-label flex1">清空数据</text>
      <text class="m-arrow">›</text>
    </view>
    <view class="menu-row last" bindtap="about">
      <text class="m-ico">ℹ️</text>
      <text class="m-label flex1">关于</text>
      <text class="m-arrow">›</text>
    </view>
  </view>

  <view class="foot-tip">健康管家 v1.0.0 · 数据仅保存在本机</view>
</view>
