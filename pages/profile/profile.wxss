/* pages/profile/profile.wxss */
.pf-page { padding: 28rpx 28rpx 60rpx; }

.user-card {
  display: flex; align-items: center; gap: 24rpx;
  background: linear-gradient(145deg, #0E7C66, #10997C);
  border-radius: 24rpx; padding: 32rpx; color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(14,124,102,0.26);
}
.avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: rgba(255,255,255,0.22); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; font-weight: 700;
}
.u-name { font-size: 36rpx; font-weight: 700; }
.u-info { font-size: 24rpx; opacity: 0.85; margin-top: 6rpx; }
.u-edit { font-size: 24rpx; padding: 10rpx 24rpx; border: 2rpx solid rgba(255,255,255,0.6); border-radius: 999rpx; }

.block-title { display: block; margin: 36rpx 4rpx 16rpx; }

.bmi-card { margin-top: 24rpx; }
.bmi-label { font-size: 26rpx; color: var(--c-text-2); }
.bmi-val { font-size: 48rpx; font-weight: 700; margin-top: 6rpx; }
.bmi-bar { display: flex; gap: 6rpx; margin-top: 24rpx; height: 14rpx; }
.bmi-seg { flex: 1; border-radius: 4rpx; }
.seg-1 { background: #F5C281; }
.seg-2 { background: var(--c-good); }
.seg-3 { background: var(--c-mid); }
.seg-4 { background: var(--c-bad); }
.bmi-legend { display: flex; justify-content: space-between; margin-top: 10rpx; font-size: 20rpx; color: var(--c-text-3); }

.goals { }
.goal-row { display: flex; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid var(--c-line); }
.goal-row.last { border-bottom: none; }
.goal-l { font-size: 28rpx; color: var(--c-text-2); }
.goal-v { font-size: 30rpx; font-weight: 600; }

.stats { display: flex; gap: 16rpx; }
.stat { flex: 1; text-align: center; padding: 28rpx 12rpx; }
.stat-num { font-size: 44rpx; font-weight: 700; color: var(--c-primary); }
.stat-l { font-size: 22rpx; color: var(--c-text-3); margin-top: 6rpx; }

.menu { margin-top: 36rpx; padding: 0 28rpx; }
.menu-row { display: flex; align-items: center; gap: 20rpx; padding: 30rpx 0; border-bottom: 1rpx solid var(--c-line); }
.menu-row.last { border-bottom: none; }
.m-ico { font-size: 36rpx; }
.m-label { font-size: 30rpx; }
.m-arrow { font-size: 36rpx; color: var(--c-text-3); }
.foot-tip { text-align: center; font-size: 22rpx; color: var(--c-text-3); margin-top: 40rpx; }
