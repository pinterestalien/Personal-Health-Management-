/* pages/record/record.wxss */
.rec-page { padding: 24rpx 28rpx 120rpx; }

.tabs { white-space: nowrap; margin-bottom: 28rpx; }
.tab-inner { display: inline-flex; gap: 16rpx; padding: 4rpx; }
.tab {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 14rpx 26rpx; border-radius: 999rpx;
  background: var(--c-surface); color: var(--c-text-2);
  font-size: 26rpx; box-shadow: var(--shadow-soft);
}
.tab.on { background: var(--c-primary); color: #fff; }
.tab-ico { font-size: 28rpx; }
.tab-t { font-size: 26rpx; }

.trend-card { margin-bottom: 24rpx; }
.chart { display: flex; align-items: flex-end; height: 240rpx; gap: 14rpx; padding-top: 16rpx; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
.bar-track { flex: 1; width: 100%; display: flex; align-items: flex-end; justify-content: center; }
.bar { width: 56%; max-width: 44rpx; background: linear-gradient(180deg, #1AA88A, #0E7C66); border-radius: 10rpx 10rpx 4rpx 4rpx; min-height: 6rpx; transition: height 0.4s; }
.bar-val { font-size: 18rpx; color: var(--c-text-2); margin-top: 6rpx; }
.bar-label { font-size: 20rpx; color: var(--c-text-3); margin-top: 4rpx; }

.list { }
.rec { display: flex; align-items: center; padding: 26rpx; margin-bottom: 16rpx; }
.rec-main { flex: 1; }
.rec-val { font-size: 40rpx; font-weight: 700; letter-spacing: -0.5rpx; }
.rec-unit { font-size: 22rpx; color: var(--c-text-3); margin-left: 6rpx; font-weight: 400; }
.rec-meta { font-size: 22rpx; color: var(--c-text-3); margin-top: 6rpx; }
.rec-note { font-size: 24rpx; color: var(--c-text-2); margin-top: 8rpx; }
.rec-del { font-size: 24rpx; color: var(--c-warn); padding: 10rpx 20rpx; }
