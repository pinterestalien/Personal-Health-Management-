<!-- pages/medication/medication.wxml -->
<view class="med-page">
  <!-- 今日服药进度 -->
  <view class="progress-card">
    <view class="row-between">
      <view class="col">
        <view class="pc-title">今日服药</view>
        <view class="pc-sub">{{takenCount}}/{{totalCount}} 已完成</view>
      </view>
      <view class="pc-ring" style="background: conic-gradient(#fff {{pct * 3.6}}deg, rgba(255,255,255,0.25) 0deg);">
        <view class="pc-ring-inner">{{pct}}<text class="pc-pct">%</text></view>
      </view>
    </view>
  </view>

  <text class="section-title" style="padding:8rpx 4rpx 16rpx;display:block;">今日清单</text>

  <view class="list">
    <view class="empty-state" wx:if="{{!meds.length}}">暂无用药提醒\n点击右下角 + 添加</view>

    <view class="med card {{item.taken ? 'is-taken' : ''}}" wx:for="{{meds}}" wx:key="id">
      <view class="med-check {{item.taken ? 'checked' : ''}}" data-id="{{item.id}}" bindtap="toggle">
        <text class="check-mark" wx:if="{{item.taken}}">✓</text>
      </view>
      <view class="med-main flex1">
        <view class="med-name-row">
          <text class="med-name {{item.taken ? 'line-through' : ''}} {{!item.enabled ? 'disabled' : ''}}">{{item.name}}</text>
          <text class="tag" wx:if="{{!item.enabled}}">已停用</text>
        </view>
        <view class="med-info">{{item.dosage}} · {{item.time}} · {{item.frequency}}</view>
        <view class="med-note" wx:if="{{item.note}}">{{item.note}}</view>
      </view>
      <view class="med-ctrl">
        <view class="mc-switch {{item.enabled ? 'on' : ''}}" data-id="{{item.id}}" bindtap="switchMed">
          <view class="mc-knob"></view>
        </view>
        <view class="mc-del" data-id="{{item.id}}" bindtap="del">删除</view>
      </view>
    </view>
  </view>

  <view class="fab" bindtap="goAdd">+</view>
</view>
