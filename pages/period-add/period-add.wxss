/* pages/period-add/period-add.wxss */
.form { padding: 28rpx 28rpx 60rpx; }
.form-header { text-align: center; padding: 24rpx 0 36rpx; }
.fh-ico { font-size: 72rpx; }
.fh-title { font-size: 36rpx; font-weight: 700; margin-top: 12rpx; }

.field { margin-bottom: 20rpx; }
.field-label { font-size: 26rpx; color: var(--c-text-2); margin-bottom: 16rpx; }
.field-input {
  font-size: 34rpx; font-weight: 600; color: var(--c-text);
  padding: 8rpx 0; border-bottom: 2rpx solid var(--c-line);
}
.field-input.picker { line-height: 1.6; }
.switch-tip { font-size: 22rpx; color: var(--c-text-3); margin-top: 12rpx; }

.switch {
  width: 76rpx; height: 40rpx; border-radius: 999rpx; background: #DDE4E2; position: relative; transition: background .2s;
}
.switch.on { background: var(--c-primary); }
.knob { width: 32rpx; height: 32rpx; border-radius: 50%; background: #fff; position: absolute; top: 4rpx; left: 4rpx; transition: left .2s; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.15); }
.switch.on .knob { left: 40rpx; }

.chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip {
  padding: 12rpx 28rpx; border-radius: 999rpx; background: var(--c-surface-2);
  font-size: 26rpx; color: var(--c-text-2); border: 2rpx solid var(--c-line);
}
.chip.on { background: var(--c-primary-soft); color: var(--c-primary); border-color: var(--c-primary); font-weight: 600; }
.btn-primary { margin-top: 16rpx; }
